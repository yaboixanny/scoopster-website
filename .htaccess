# Retired Newmarket service-area page
RewriteEngine On
# Consolidated Ancaster park guide
RewriteRule ^blog/best-dog-parks-in-ancaster(?:/index\.html|/)?$ /blog/best-dog-parks-hamilton/ [R=301,L]
RewriteRule ^service-areas/newmarket(?:/index\.html|/)?$ / [R=301,L]

# Ensure XML files are served with correct MIME type
<FilesMatch "\.xml$">
  Header set Content-Type "application/xml; charset=utf-8"
</FilesMatch>

# Enable CORS for sitemap
<FilesMatch "sitemap\.xml$">
  Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Keep the authoring template out of search results.
<Files "blog-post-template.html">
  Header set X-Robots-Tag "noindex, nofollow"
</Files>
